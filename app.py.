import streamlit as st
import yfinance as yf
import plotly.graph_objects as go

# ---------------------------------------------------------
# 1. KONFIGURASI TAMPILAN DASHBOARD
# ---------------------------------------------------------
st.set_page_config(page_title="AI Forex Terminal", layout="wide", page_icon="📈")

st.title("🤖 AI Forex Trading Terminal")
st.caption("Platform Analisis Pasar, Kalkulator Lot, & Sentimen AI Personal")

# ---------------------------------------------------------
# 2. SIDEBAR - PENGATURAN PAIR & TIMEFRAME
# ---------------------------------------------------------
st.sidebar.header("⚙️ Panel Kontrol")
pair_selected = st.sidebar.selectbox(
    "Pilih Pair Forex / Emas",
    ["EURUSD=X", "GBPUSD=X", "USDJPY=X", "AUDUSD=X", "GC=F"] # GC=F = Gold/XAUUSD
)

timeframe = st.sidebar.selectbox("Timeframe Chart", ["1d", "1h", "15m"])

# ---------------------------------------------------------
# 3. GRAFIK CHART CANDLESTICK INTERAKTIF
# ---------------------------------------------------------
st.subheader(f"📊 Chart Live: {pair_selected.replace('=X', '')}")

try:
    data = yf.download(tickers=pair_selected, period="7d", interval=timeframe)
    
    if not data.empty:
        # Merapikan struktur data jika ada MultiIndex dari yfinance
        if isinstance(data.columns, tuple):
            data.columns = [col[0] for col in data.columns]
            
        fig = go.Figure(data=[go.Candlestick(
            x=data.index,
            open=data['Open'],
            high=data['High'],
            low=data['Low'],
            close=data['Close'],
            name="Candlestick"
        )])
        fig.update_layout(
            xaxis_rangeslider_visible=False, 
            template="plotly_dark",
            height=450,
            margin=dict(l=20, r=20, t=30, b=20)
        )
        st.plotly_chart(fig, use_container_width=True)
    else:
        st.warning("Data chart tidak ditemukan. Coba ganti timeframe atau pair.")
except Exception as e:
    st.error(f"Gagal memuat chart: {e}")

# ---------------------------------------------------------
# 4. KALKULATOR RISK MANAGEMENT & LOT SIZE
# ---------------------------------------------------------
st.markdown("---")
st.subheader("🧮 Kalkulator Lot & Manajemen Resiko")

col1, col2, col3 = st.columns(3)

with col1:
    balance = st.number_input("Modal Account ($)", min_value=10.0, value=1000.0, step=50.0)
with col2:
    risk_pct = st.number_input("Resiko per Trade (%)", min_value=0.1, max_value=10.0, value=1.0, step=0.5)
with col3:
    sl_pips = st.number_input("Jarak Stop Loss (Pips)", min_value=1.0, value=30.0, step=5.0)

if sl_pips > 0:
    risk_usd = balance * (risk_pct / 100)
    # Perhitungan standar lot forex (1 Pips per Standard Lot ≈ $10 pada EURUSD)
    lot_recommended = risk_usd / (sl_pips * 10)
    
    st.info(f"""
    💡 **Hasil Perhitungan:**
    - Maksimal Kerugian Toleransi: **${risk_usd:.2f}**
    - Rekomendasi Ukuran Posisi: **{lot_recommended:.2f} Lot**
    """)

# ---------------------------------------------------------
# 5. ASISTEN AI ANALISIS PASAR
# ---------------------------------------------------------
st.markdown("---")
st.subheader("💡 Asisten AI Bias Pasar")

if st.button("Jalankan Analisis AI Sekarang", type="primary"):
    if not data.empty and len(data) >= 2:
        last_close = float(data['Close'].iloc[-1])
        prev_close = float(data['Close'].iloc[-2])
        change = last_close - prev_close
        
        if change > 0:
            st.success(f"🟢 **Bias AI: BULLISH (Potensi Naik)**\nHarga terakhir naik dibanding candle sebelumnya (+{change:.4f}). Cari konfirmasi Buy pada Support!")
        else:
            st.error(f"🔴 **Bias AI: BEARISH (Potensi Turun)**\nHarga terakhir turun dibanding candle sebelumnya ({change:.4f}). Cari konfirmasi Sell pada Resistance!")
    else:
        st.warning("Data tidak cukup untuk dianalisis oleh AI.")
